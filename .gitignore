# --- Operating system / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Composer ---
# vendor/ is regenerated during the build (bin/build.sh) and included ONLY in
# the distributable zip, so Composer is not required on the production server.
/system-markdown-alternate/vendor/

# --- Node (possible future tooling) ---
node_modules/

# --- Temporary build / staging ---
/build/
/.build-tmp/
*.log

# DIST/ is where bin/build.sh writes the zip. It is a local build output, not a
# committed artifact: both release paths (the GitHub Release and the
# wordpress.org deploy) rebuild the package from the tag, so a copy in the
# repository is read by nothing and can only fall behind the source.
/DIST/

# NOTE: composer.lock is intentionally versioned for reproducible builds.
